{
  "name": "axes-mundi",
  "version": "1.0.0",
  "description": "Educational sorting game with multiple axes (time, height, mass, etc.)",
  "main": "dist/main/index.js",
  "author": "Jochen Hagen",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -n VITE,ELECTRON -c blue,magenta \"npm:vite:dev\" \"npm:electron:dev\"",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "vite:preview": "vite preview",
    "electron:dev": "npm run build:main && npm run build:preload && wait-on tcp:5179 && cross-env NODE_ENV=development electron .",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "electron:build": "npm run vite:build && electron-builder",
    "build": "npm run build:main && npm run build:preload && npm run vite:build && electron-builder",
    "preview": "npm run vite:preview",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "clean": "rimraf dist logs",
    "logs:tail": "powershell -File scripts\\tail-logs.ps1",
    "logs:bundle": "powershell -File scripts\\bundle-logs.ps1"
  },
  "dependencies": {
    "@xstate/react": "^3.1.1",
    "adm-zip": "^0.5.16",
    "gsap": "^3.12.2",
    "pino": "^8.17.2",
    "pixi.js": "^7.3.2",
    "ws": "^8.14.2",
    "xstate": "^4.38.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^20.8.0",
    "@types/ws": "^8.5.8",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "@typescript-eslint/parser": "^6.9.0",
    "@vitejs/plugin-react": "^4.1.0",
    "@vitest/coverage-v8": "^0.34.6",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4",
    "eslint": "^8.52.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "playwright": "^1.39.0",
    "prettier": "^3.0.3",
    "rimraf": "^5.0.5",
    "typescript": "^5.2.2",
    "vite": "^4.5.0",
    "vitest": "^0.34.6",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.axesmundi.app",
    "productName": "Axes-Mundi",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/main/**/*",
      "dist/preload/**/*",
      "dist/renderer/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
